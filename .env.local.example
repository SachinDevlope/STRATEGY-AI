# Copy to .env.local and fill in.

# Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB Atlas connection string. The database name goes at the end of the path
# (e.g. .../Gen-Ai) — Auth.js and getDb() both use it.
MONGODB_URI=

# Vercel AI Gateway. Models are referenced as "provider/model" strings (see
# lib/ai.ts), so this one key covers every provider. Create it at
# vercel.com > AI Gateway > API Keys. On Vercel deployments OIDC is used
# instead and this can be left unset.
AI_GATEWAY_API_KEY=

# Vercel Blob store token (private PDF storage). Get it with `vercel env pull`
# after creating a Blob store, or from the store's settings page.
BLOB_READ_WRITE_TOKEN=

# Canonical origin used to build the OAuth callback URL. On Vercel this is
# derived automatically from VERCEL_PROJECT_PRODUCTION_URL (see auth.config.ts),
# so only set it to override — e.g. once a custom domain replaces the .vercel.app
# one. Must match the redirect URI registered in the Google Cloud Console.
# AUTH_URL=https://strategy-ai.example.com
