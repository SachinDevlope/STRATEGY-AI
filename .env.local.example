# Copy to .env.local and fill in.

# Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB Atlas connection string. The database name goes at the end of the path
# (e.g. .../Gen-Ai) — Auth.js and getDb() both use it.
MONGODB_URI=

# Groq API key for all AI generation (lib/ai.ts). Get one at console.groq.com.
GROQ_API_KEY=
# Optional: override the main model (default openai/gpt-oss-120b).
# GROQ_MODEL=

# Vercel Blob store token (private PDF storage). Get it with `vercel env pull`
# after creating a Blob store, or from the store's settings page.
BLOB_READ_WRITE_TOKEN=

# Canonical origin used to build the OAuth callback URL. Production builds
# already default to PRODUCTION_ORIGIN in auth.config.ts, so set this only to
# override — e.g. once a custom domain replaces the .vercel.app one. Whatever it
# points at must be registered as a redirect URI in the Google Cloud Console.
# AUTH_URL=https://strategy-ai.example.com
